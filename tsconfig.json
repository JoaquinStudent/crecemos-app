{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "paths": {
      "@theme": ["./src/theme"],
      "@theme/*": ["./src/theme/*"],
      "@components/*": ["./src/components/*"],
      "@context/*": ["./src/context/*"],
      "@services/*": ["./src/services/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@screens/*": ["./src/screens/*"],
      "@navigation/*": ["./src/navigation/*"],
      "@storage/*": ["./src/storage/*"],
      "@dominio/*": ["./src/dominio/*"],
      "@analisis/*": ["./src/analisis/*"]
    }
  }
}
